# Virtual environment
venv/
.venv/

# Environment variables (API keys, never commit)
.env
.streamlit/secrets.toml

# Python cache
__pycache__/
*.pyc

# Database file (legacy SQLite era)
*.db

# Streamlit cache
.streamlit/cache

# Editor backups
*.bak
*.bak-*

# Landing page, deployed straight to S3, deliberately kept out of the repo
telos-site/

# Secret bundles used by the deploy script. The -EnvFile flow asks you to write
# real production credentials to a plain text file; if one of those ever lands
# next to the repo, it must not be committable.
telos-secrets.txt
*secrets*.txt
*.secrets
